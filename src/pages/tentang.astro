---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, socials, storeNotes, waLink } from '../data/business';
const embed = `https://maps.google.com/maps?q=${encodeURIComponent(business.mapsQuery)}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
const cta = waLink(`Halo ${business.name}, saya mau tanya rute dan stok produk.`);
---
<BaseLayout title={`Tentang — ${business.title}`} description={`Dua cabang ${business.name} Broni & Mayang: alamat, jam, WA Broni, akun PT Bersama Glamindo.`} canonicalPath="/tentang" image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 py-12 w-full min-h-[70dvh]">
    <p class="text-sm font-bold uppercase tracking-wide text-emerald-700 reveal">Tentang — 2 Cabang</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-black uppercase max-w-[20ch] reveal d-1">{business.name}</h1>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-7 order-2 md:order-1 reveal d-2">
        <div class="rounded-[2rem] overflow-hidden border border-slate-200/50 aspect-video bg-zinc-100">
          <iframe title={`Peta ${business.name}`} src={embed} loading="lazy" class="w-full h-full"></iframe>
        </div>
        <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
          <div class="bg-white border border-slate-200/50 rounded-3xl p-5"><p class="font-bold">Cabang Broni</p><p class="mt-1 text-base text-gray-600">Sebelah UNBARI • {business.hours}</p></div>
          <div class="bg-white border border-slate-200/50 rounded-3xl p-5"><p class="font-bold">Cabang Mayang</p><p class="mt-1 text-base text-gray-600">Jl Ir H Juanda No.10B, Kota Baru</p></div>
        </div>
        <div class="mt-4 bg-white border border-slate-200/50 rounded-[2rem] p-8">
          <h2 class="font-bold tracking-tight text-lg">Catatan Toko</h2>
          <ul class="mt-3 text-base text-gray-600 leading-relaxed list-disc pl-5">{storeNotes.map((n) => (<li>{n}</li>))}</ul>
        </div>
      </div>
      <div class="md:col-span-5 order-1 md:order-2 reveal d-3">
        <div class="bg-zinc-950 text-white rounded-[2rem] p-8">
          <h2 class="font-black uppercase tracking-tight text-lg">Kontak & Akun Resmi</h2>
          <p class="mt-3 text-base text-zinc-400">Telp/WA: {business.phoneDisplay}</p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a href={cta} class="bg-emerald-700 text-white px-6 py-3 rounded-full text-sm font-medium active:scale-[0.98]">Chat WhatsApp</a>
            <a href={business.mapsUrl} class="border border-white/20 px-6 py-3 rounded-full text-sm font-medium active:scale-[0.98]">Cari di Maps</a>
          </div>
          <ul class="mt-6 flex flex-col gap-2 text-sm text-zinc-300">{socials.map((s) => (<li><a href={s.url} class="underline underline-offset-4 text-white">{s.label}</a> <span class="text-zinc-500">— {s.note}</span></li>))}</ul>
        </div>
        <div class="mt-4 bg-white border border-slate-200/50 rounded-[2rem] p-6">
          <h2 class="font-bold tracking-tight px-2">Galeri Toko</h2>
          <figure class="mt-4 px-2"><div class="rounded-3xl overflow-hidden bg-zinc-100 aspect-[4/3]"><img src="/images/missglam-toko-2.jpg" alt="Suasana dalam toko Miss Glam — foto resmi perusahaan" width="800" height="600" loading="lazy" class="w-full h-full object-cover" /></div><figcaption class="mt-2 text-xs text-zinc-400">Sumber: missglam.id</figcaption></figure>
          <figure class="mt-4 px-2"><div class="rounded-3xl overflow-hidden bg-zinc-100 aspect-[4/3]"><img src="/images/missglam-toko-3.jpg" alt="Interior toko Miss Glam — foto resmi perusahaan" width="800" height="600" loading="lazy" class="w-full h-full object-cover" /></div><figcaption class="mt-2 text-xs text-zinc-400">Sumber: missglam.id</figcaption></figure>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
