---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, products, promos, waLink } from '../data/business';
const heroCta = waLink(`Halo ${business.name}, apakah stok produk best seller ready?`);
const featured = products.slice(0, 6);
const marquee = [...promos, ...promos];
---
<BaseLayout title={business.title} description={business.description} canonicalPath="/" image={business.ogImage}>
  <!-- kinetic marquee promo -->
  <div class="marquee bg-emerald-700 text-white py-2.5 text-sm font-medium" aria-hidden="true">
    <div class="marquee-track">
      {marquee.map((m) => (<span>{m.title} — {m.status}</span>))}
    </div>
  </div>

  <!-- HERO mirror: visual kiri, teks kanan -->
  <section class="max-w-7xl mx-auto px-4 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center min-h-[88dvh] py-10">
      <div class="md:col-span-5 order-1 reveal">
        <div class="rounded-[2.5rem] overflow-hidden border border-slate-200/50 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] bg-zinc-100 aspect-[4/5]">
          <img src="/images/missglam-hero.jpg" alt="Etalase resmi Miss Glam Jambi — foto perusahaan" width="800" height="1000" loading="eager" class="w-full h-full object-cover" />
        </div>
        <div class="mt-3 flex gap-3">
          <div class="rounded-2xl overflow-hidden bg-zinc-100 aspect-square w-1/2"><img src="/images/missglam-toko-2.jpg" alt="Suasana dalam toko Miss Glam — foto resmi perusahaan" width="400" height="400" loading="lazy" class="w-full h-full object-cover" /></div>
          <div class="rounded-2xl overflow-hidden bg-zinc-100 aspect-square w-1/2"><img src="/images/missglam-toko-3.jpg" alt="Interior toko Miss Glam — foto resmi perusahaan" width="400" height="400" loading="lazy" class="w-full h-full object-cover" /></div>
        </div>
      </div>
      <div class="md:col-span-7 order-2 reveal d-1">
        <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-emerald-700">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.8-4.5 4.2 1.1 6-5.4-3-5.4 3 1.1-6L3.2 9.4l6.1-.8z"/></svg>
          <span>{business.rating} • {business.category} • 2 Cabang</span>
        </p>
        <h1 class="mt-4 text-4xl md:text-6xl tracking-tighter leading-none font-black uppercase">Miss Glam Jambi — Kosmetik Original 2 Cabang</h1>
        <p class="mt-5 text-base text-gray-600 leading-relaxed max-w-[65ch]">Broni sebelah UNBARI & Mayang Simpang III Sipin. Naungan PT Bersama Glamindo — stok bisa dicek silang antar cabang via WhatsApp Broni.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={heroCta} class="bg-emerald-700 text-white px-7 py-3.5 rounded-full font-medium transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]" style="transition-timing-function:cubic-bezier(0.16,1,0.3,1)">Pesan via WhatsApp</a>
          <a href="/katalog" class="border border-zinc-300 px-7 py-3.5 rounded-full font-medium transition-all duration-300 hover:border-zinc-950 active:scale-[0.98]">Lihat Katalog</a>
        </div>
        <dl class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
          <div class="bg-white border border-slate-200/50 rounded-3xl p-5 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]"><dt class="font-bold">Cabang Broni</dt><dd class="mt-1 text-base text-gray-600">Sebelah UNBARI • {business.hours}</dd></div>
          <div class="bg-white border border-slate-200/50 rounded-3xl p-5 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]"><dt class="font-bold">Cabang Mayang</dt><dd class="mt-1 text-base text-gray-600">Jl Ir H Juanda No.10B, Kota Baru</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- katalog: horizontal snap mobile + masonry 2fr/1fr desktop -->
  <section class="max-w-7xl mx-auto px-4 py-12 w-full">
    <p class="text-sm font-bold uppercase tracking-wide text-emerald-700 reveal">Sorotan Katalog</p>
    <h2 class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-black uppercase reveal d-1">Produk Unggulan</h2>
    <p class="mt-3 text-base text-gray-600 leading-relaxed max-w-[65ch]">Harga estimasi, konfirmasi via WA. <a class="underline underline-offset-4 text-zinc-900" href="/katalog">Lihat semua {products.length} produk</a></p>
    <div class="snap-row mt-8 flex gap-5 overflow-x-auto pb-4 md:grid md:grid-cols-3 md:overflow-visible" style="grid-template-columns:2fr 1fr 1fr">
      {featured.map((p, i) => (
        <article class:list={["reveal shrink-0 w-[78vw] md:w-auto", i === 0 && "md:row-span-2"]} style={`animation-delay:${0.08 + i * 0.07}s`}>
          <div class="bg-white border border-slate-200/50 rounded-[2rem] p-5 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)] transition-all duration-300 hover:-translate-y-1 h-full">
            <div class:list={["rounded-3xl overflow-hidden bg-zinc-100", i === 0 ? "aspect-[4/5]" : "aspect-[4/3]"]}>
              <img src={p.image} alt={p.alt} width={p.w} height={p.h} loading="lazy" class="w-full h-full object-cover" />
            </div>
            <p class="mt-4 text-xs font-bold uppercase tracking-wide text-emerald-700">{p.badge} • {p.stock}</p>
            <h3 class="mt-1 font-bold text-lg tracking-tight">{p.name}</h3>
            <p class="mt-1 text-xs text-zinc-400">{p.source}</p>
            <div class="mt-3 flex items-center justify-between gap-2">
              <p class="font-bold text-sm">{p.price}</p>
              <a href={waLink(`Halo ${business.name}, saya mau pesan ${p.name} (${p.price}). Apakah ready?`)} class="bg-zinc-950 text-white px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]">Pesan</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-14 w-full">
    <div class="bg-zinc-950 text-white rounded-[2.5rem] p-8 md:p-12 reveal">
      <h2 class="text-3xl md:text-4xl tracking-tighter leading-none font-black uppercase max-w-[20ch]">Stok Broni kosong? Tanya Mayang.</h2>
      <p class="mt-3 text-base text-zinc-400 leading-relaxed max-w-[65ch]">Admin bantu cek silang dua cabang. Jelajahi <a class="underline underline-offset-4 text-white" href="/katalog">katalog</a>, <a class="underline underline-offset-4 text-white" href="/promo">promo</a>, <a class="underline underline-offset-4 text-white" href="/tentang">info toko</a>.</p>
      <a href={waLink(`Halo ${business.name}, saya mau reservasi produk.`)} class="mt-6 inline-block bg-emerald-700 text-white px-8 py-3.5 rounded-full font-medium transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]">Chat WhatsApp Sekarang</a>
    </div>
  </section>
</BaseLayout>
