---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, promos, waLink } from '../data/business';
---
<BaseLayout title={`Promo — ${business.title}`} description={`Promo ${business.name} Broni & Mayang: bundling hemat & update Shopee TikTok resmi. Cek WA.`} canonicalPath="/promo" image={business.ogImage}>
  <div class="marquee bg-emerald-700 text-white py-2.5 text-sm font-medium" aria-hidden="true"><div class="marquee-track">{[...promos, ...promos].map((m) => (<span>{m.title} — {m.status}</span>))}</div></div>
  <section class="max-w-7xl mx-auto px-4 py-12 w-full min-h-[70dvh]">
    <p class="text-sm font-bold uppercase tracking-wide text-emerald-700 reveal">Promo</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-black uppercase max-w-[20ch] reveal d-1">Promo {business.name}</h1>
    <p class="mt-3 text-base text-gray-600 leading-relaxed max-w-[65ch]">Berlaku di Broni & Mayang. Estimasi mengikuti info toko — konfirmasi via WA sebelum order.</p>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-7 reveal d-2">
        <div class="bg-zinc-950 text-white rounded-[2rem] p-8 md:p-10 h-full">
          <p class="text-xs font-bold uppercase tracking-wide text-emerald-400">{promos[0].status}</p>
          <h2 class="mt-2 font-black uppercase text-xl tracking-tight">{promos[0].title}</h2>
          <p class="mt-2 text-base text-zinc-400 leading-relaxed max-w-[65ch]">{promos[0].desc}</p>
          <a href={waLink(`Halo ${business.name}, saya mau klaim promo: ${promos[0].title}.`)} class="mt-5 inline-block bg-emerald-700 text-white px-6 py-3 rounded-full text-sm font-medium active:scale-[0.98]">Klaim via WA</a>
        </div>
      </div>
      <div class="md:col-span-5 flex flex-col gap-6">
        {promos.slice(1).map((m, i) => (
          <div class:list={["reveal bg-white border border-slate-200/50 rounded-[2rem] p-8 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]"]} style={`animation-delay:${0.15 + i * 0.08}s`}>
            <p class="text-xs font-bold uppercase tracking-wide text-emerald-700">{m.status}</p>
            <h2 class="mt-2 font-bold text-xl tracking-tight">{m.title}</h2>
            <p class="mt-2 text-base text-gray-600 leading-relaxed">{m.desc}</p>
            <a href={waLink(`Halo ${business.name}, saya mau klaim promo: ${m.title}.`)} class="mt-5 inline-block bg-zinc-950 text-white px-6 py-3 rounded-full text-sm font-medium active:scale-[0.98]">Klaim via WA</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
